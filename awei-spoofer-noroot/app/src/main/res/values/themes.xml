<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AweiSpoofer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <!-- 全部 MaterialCardView 默认 outlined 风格：暗色主题下描边比投影阴影干净，
             圆角/描边统一收敛（不改任何布局树与 id，纯视觉） -->
        <item name="materialCardViewStyle">@style/AppCard</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- 次要操作：描边按钮（与主操作 filled 形成层级）；文字用亮蓝——
         M3 outlined 默认继承 colorPrimary（深蓝 #1565C0），暗底对比只有约 3:1 不达标；
     破坏性操作叠加红字红描边 -->
    <style name="AppBtnOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary_light</item>
    </style>

    <style name="AppBtnDestructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/state_fail</item>
        <item name="strokeColor">@color/state_fail</item>
    </style>
</resources>
