<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模拟模式"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_fixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/mode_fixed" />

            <RadioButton
                android:id="@+id/rb_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/mode_route" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_point_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_point_hint"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="移动速度: 10 km/h"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_preset_walk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp"
                        android:text="散步 5"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_preset_brisk"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp"
                        android:text="快走 7"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_preset_jog"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp"
                        android:text="慢跑 10"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_preset_run"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp"
                        android:text="快跑 15"
                        android:textSize="11sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="115"
                    android:progress="5" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_variable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="配速自然波动（步行/跑步建议开启）" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_loop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="到达终点后循环" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_gen_loop"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="一键生成跑步环线（沿真实道路绕圈）" />

        <TextView
            android:id="@+id/tv_loop_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="先在地图页长按设置环线中心（轨迹模式下的「起点」），再点上面按钮选距离"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/start_mock" />

        <Button
            android:id="@+id/btn_stop"
            style="@style/AppBtnDestructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/stop_mock" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_hold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="起跑 / 暂停" />

            <Button
                android:id="@+id/btn_float"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="浮窗: 关" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_track_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="--" />
    </LinearLayout>
</ScrollView>
